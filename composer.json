{
    "name": "nandordudas/state-machine",
    "description": "A small, strictly typed finite state machine for PHP (inspired by xstate.js and mouadziani/xstate)",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "state machine",
        "fsm",
        "workflow",
        "xstate"
    ],
    "homepage": "https://github.com/nandordudas/statemachine",
    "support": {
        "issues": "https://github.com/nandordudas/statemachine/issues",
        "source": "https://github.com/nandordudas/statemachine",
        "security": "https://github.com/nandordudas/statemachine/security/policy"
    },
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Dudas\\StateMachine\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Dudas\\StateMachine\\Tests\\": "tests/",
            "Dudas\\StateMachine\\Examples\\": "examples/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "php-cs-fixer fix --allow-risky=yes",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "archive": {
        "exclude": ["/vendor", "/dist"]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "3.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
