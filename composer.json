{
    "name": "nandordudas/state-machine-php72",
    "description": "PHP 7.2 compatible port of nandordudas/state-machine: a small, strictly typed finite state machine (no enums)",
    "type": "library",
    "license": "MIT",
    "keywords": ["state machine", "fsm", "workflow", "xstate"],
    "homepage": "https://github.com/nandordudas/statemachine",
    "support": {
        "issues": "https://github.com/nandordudas/statemachine/issues",
        "source": "https://github.com/nandordudas/statemachine/tree/php72"
    },
    "require": {
        "php": ">=7.2"
    },
    "conflict": {
        "nandordudas/state-machine": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^2.19",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^8.5"
    },
    "autoload": {
        "psr-4": {
            "Dudas\\StateMachine\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Dudas\\StateMachine\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "php-cs-fixer fix --allow-risky=yes",
        "check": ["@analyse", "@test"]
    },
    "archive": {
        "exclude": ["/tests", "/.github", "/.vscode", "/.claude", "/.editorconfig", "/AGENTS.md", "/CLAUDE.md", "/mago.toml", "/phpstan.neon.dist", "/phpunit.xml.dist", "/.php-cs-fixer.dist.php", "/dist"]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "7.2.5"
        }
    },
    "minimum-stability": "stable"
}
